{
  "name": "web-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "capture": "node scripts/wt.mjs capture",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build && node scripts/verify.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "site-check": "node scripts/wt.mjs site-check",
    "watch": "node scripts/wt.mjs watch",
    "inventory": "node scripts/wt.mjs inventory",
    "content": "node scripts/wt.mjs content",
    "release": "node scripts/wt.mjs release",
    "test:unit": "node --test tests/content.test.mjs tests/inventory.test.mjs tests/lighthouse-history.test.mjs tests/model.test.mjs tests/release.test.mjs",
    "format": "prettier --check .",
    "wt": "node scripts/wt.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "robots-parser": "^3.0.1",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "wt": "scripts/wt.mjs"
  }
}
